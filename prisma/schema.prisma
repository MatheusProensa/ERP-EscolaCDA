// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                 String         @id @default(cuid())
  name               String
  email              String         @unique
  password           String
  role               Role           @default(SECRETARIA)
  /// Foto de perfil (JPEG em base64, redimensionado no navegador antes do
  /// upload — ver components/ui/PhotoUpload.tsx). Vira o "image" padrão do
  /// NextAuth na sessão.
  foto               String?
  tentativasFalhas   Int            @default(0)
  bloqueadoAte       DateTime?
  /// Marcado quando o usuário pede "esqueci minha senha" na tela de login —
  /// sem envio de e-mail (não tem provedor configurado), um ADMIN/DIREÇÃO vê
  /// o pedido na tela de Usuários e redefine manualmente (fluxo que já existia).
  pedidoResetSenhaEm DateTime?
  createdAt          DateTime       @default(now())
  mensagensEnviadas  Mensagem[]     @relation("MensagensEnviadas")
  mensagensRecebidas Mensagem[]     @relation("MensagensRecebidas")
  notificacoes       Notificacao[]
  avisosMural        MuralAviso[]
  leiturasAvisos     AvisoLeitura[]
  permissoes         PermissaoUsuario[]
}

/// Permissão granular por pessoa/setor — sobrepõe o pacote padrão do Role
/// quando existe uma linha aqui pro (usuário, módulo). Sem linha = usa o
/// que o Role já libera (comportamento de sempre). Ver lib/permissoes.ts.
model PermissaoUsuario {
  id        String         @id @default(cuid())
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  modulo    String
  nivel     NivelPermissao
  updatedAt DateTime       @updatedAt

  @@unique([userId, modulo])
  @@index([userId])
}

enum NivelPermissao {
  NENHUM
  VER
  EDITAR
}

model Mensagem {
  id             String    @id @default(cuid())
  remetente      User      @relation("MensagensEnviadas", fields: [remetenteId], references: [id])
  remetenteId    String
  destinatario   User      @relation("MensagensRecebidas", fields: [destinatarioId], references: [id])
  destinatarioId String
  conteudo       String?
  anexoNome      String?
  anexo          String?
  lida           Boolean   @default(false)
  excluida       Boolean   @default(false)
  editadaEm      DateTime?
  createdAt      DateTime  @default(now())
  /// Muda em qualquer alteração (lida, edição, exclusão) — é o que o polling
  /// incremental usa pra saber que uma mensagem JÁ mostrada na tela mudou,
  /// não só pra achar mensagem nova.
  updatedAt      DateTime  @default(now()) @updatedAt

  // "createdAt" no fim de cada uma cobre o ORDER BY + LIMIT de abrir uma
  // conversa (pega as mais recentes) sem precisar ordenar a conversa inteira
  // na mão — uma índice pra cada lado do OR (remetente/destinatário trocados).
  @@index([remetenteId, destinatarioId, createdAt])
  @@index([destinatarioId, remetenteId, createdAt])
  @@index([destinatarioId, lida])
}

model Notificacao {
  id        String   @id @default(cuid())
  usuario   User     @relation(fields: [usuarioId], references: [id])
  usuarioId String
  tipo      String
  titulo    String
  corpo     String?
  link      String?
  lida      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([usuarioId, lida])
}

enum Role {
  ADMIN
  DIRECAO
  SECRETARIA // legado, não usado em novos cadastros — ver ADMINISTRATIVO
  FINANCEIRO
  PEDAGOGICO
  ADMINISTRATIVO
}

model AnoLetivo {
  id         String      @id @default(cuid())
  ano        Int         @unique
  ativo      Boolean     @default(false)
  turmas     Turma[]
  matriculas Matricula[]
}

model Turma {
  id          String        @id @default(cuid())
  nome        String
  turno       Turno
  capacidade  Int           @default(25)
  anoLetivo   AnoLetivo     @relation(fields: [anoLetivoId], references: [id])
  anoLetivoId String
  matriculas  Matricula[]
  listaEspera ListaEspera[]
  createdAt   DateTime      @default(now())

  @@unique([nome, anoLetivoId])
}

enum Turno {
  MANHA
  TARDE
}

model ListaEspera {
  id                  String            @id @default(cuid())
  nomeCrianca         String
  dataNascimento      DateTime?
  nomeResponsavel     String
  telefoneResponsavel String
  emailResponsavel    String?
  turmaDesejada       Turma?            @relation(fields: [turmaDesejadaId], references: [id])
  turmaDesejadaId     String?
  observacoes         String?
  status              StatusListaEspera @default(AGUARDANDO)
  createdAt           DateTime          @default(now())
}

enum StatusListaEspera {
  AGUARDANDO
  CONTATADO
  MATRICULADO
  DESISTIU
}

model Aluno {
  id                 String   @id @default(cuid())
  nome               String
  nomeSocial         String?
  dataNascimento     DateTime
  naturalidade       String?
  cpf                String?  @unique
  rg                 String?
  certidaoNascimento String?
  foto               String?
  endereco           String?
  bairro             String?
  cidade             String?
  cep                String?
  tipoSanguineo      String?
  convenioMedico     String?
  medicacaoContinua  String?
  alergias           String?
  restricoes         String?
  necessidadesEsp    String?
  autorizacaoImagem  Boolean  @default(false)

  // Dados do Censo Escolar (Educacenso)
  sexo            Sexo?
  racaCor         RacaCor?
  povoIndigena    String?
  nacionalidade   Nacionalidade @default(BRASILEIRA)
  municipioNasc   String?
  ufNasc          String?
  filiacao1       String?
  filiacao2       String?
  bolsaFamilia    Boolean       @default(false)
  deficiencia     Boolean       @default(false)
  tipoDeficiencia String?
  recursosAcessib String?
  nis             String?

  // Dados da Ficha de Matrícula (rotina/perfil da criança)
  temIrmaos             Boolean?
  idadesIrmaos          String?
  usaBico               Boolean?
  usaMamadeira          Boolean?
  obsBicoMamadeira      String?
  jaFrequentouEscola    Boolean?
  duracaoEscolaAnterior String?
  rotinaSonoAlimentacao String?
  brincadeirasPrediletas String?
  reacoesContrariado    String?

  matriculas         Matricula[]
  responsaveis       Responsavel[]
  pessoasAutorizadas PessoaAutorizada[]
  notasFiscais       NotaFiscal[]
  boletos            Boleto[]
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  @@index([nome])
}

enum Sexo {
  M
  F
}

enum RacaCor {
  BRANCA
  PRETA
  PARDA
  AMARELA
  INDIGENA
  NAO_DECLARADA
}

enum Nacionalidade {
  BRASILEIRA
  ESTRANGEIRA
}

model Responsavel {
  id                String  @id @default(cuid())
  nome              String
  parentesco        String
  cpf               String?
  telefone          String
  telefoneFixo      String?
  telefoneComercial String?
  email             String?
  rg                String?
  escolaridade      String?
  profissao         String?
  endereco          String?
  cep               String?
  autorizado        Boolean @default(true)
  aluno             Aluno   @relation(fields: [alunoId], references: [id])
  alunoId           String
}

/// Pessoas além dos responsáveis já cadastrados que também podem buscar o aluno na escola.
model PessoaAutorizada {
  id         String @id @default(cuid())
  nome       String
  parentesco String
  aluno      Aluno  @relation(fields: [alunoId], references: [id], onDelete: Cascade)
  alunoId    String
}

model Matricula {
  id               String            @id @default(cuid())
  aluno            Aluno             @relation(fields: [alunoId], references: [id])
  alunoId          String
  turma            Turma             @relation(fields: [turmaId], references: [id])
  turmaId          String
  anoLetivo        AnoLetivo         @relation(fields: [anoLetivoId], references: [id])
  anoLetivoId      String
  situacao         SituacaoMatricula @default(ATIVA)
  dataMatricula    DateTime          @default(now())
  // Só o valor contratado — fica pra constar no contrato (lib/gerarContratoPdf).
  // A escola cobra a mensalidade por fora (Banrisul), então não existe mais
  // controle de cobrança/pagamento dentro do sistema (era Mensalidade/Pagamento).
  valorMensalidade Float?
  contrato         Contrato?
  updatedAt        DateTime          @updatedAt

  @@index([alunoId])
  @@index([turmaId])
  @@index([situacao])
  @@index([anoLetivoId])
  // Combinação mais repetida no sistema (matrícula ativa do ano letivo corrente).
  @@index([anoLetivoId, situacao])
}

enum SituacaoMatricula {
  ATIVA
  TRANCADA
  CANCELADA
  TRANSFERIDA
  CONCLUIDA
}

model Contrato {
  id          String    @id @default(cuid())
  matricula   Matricula @relation(fields: [matriculaId], references: [id])
  matriculaId String    @unique
  arquivo     String?
  assinado    Boolean   @default(false)
  dataEnvio   DateTime?
  createdAt   DateTime  @default(now())

  /// Assinatura eletrônica simples por link (MP 2.200-2/2001) — sem certificado
  /// ICP-Brasil, só registra consentimento + identificação de quem assinou.
  tokenAssinatura String?   @unique
  nomeAssinante   String?
  cpfAssinante    String?
  ipAssinatura    String?
  assinadoEm      DateTime?

  /// Retrato dos dados usados pra gerar o PDF (o que a tela de revisão deixa
  /// editar) — sem isso, assinar pelo link teria que re-derivar tudo do
  /// cadastro atual do aluno, que pode já ter mudado desde a geração e perderia
  /// coisas como dia/mês de vencimento (não existem em outro lugar do banco).
  alunoNomeSnapshot         String?
  alunoNascimentoSnapshot   DateTime?
  responsavelNomeSnapshot   String?
  responsavelCpfSnapshot    String?
  turmaNomeSnapshot         String?
  turnoLabelSnapshot        String?
  anoLetivoSnapshot         Int?
  valorMensalidadeSnapshot  Float?
  dataMatriculaSnapshot     DateTime?
  diaVencimentoSnapshot     String?
  mesInicioVencimentoSnapshot String?
}

/// NFS-e (nota fiscal de serviço) emitida via webservice ABRASF do ISS.net
/// (Prefeitura de Santa Maria) — ver lib/issnet.ts. A escola cobra a
/// mensalidade por fora (Banrisul); isso aqui é só a obrigação fiscal de
/// emitir nota do serviço prestado, independente de como foi cobrado.
model NotaFiscal {
  id                String           @id @default(cuid())
  aluno             Aluno            @relation(fields: [alunoId], references: [id])
  alunoId           String
  /// "AAAA-MM" — mês de referência do serviço (não precisa ser o mês da emissão)
  competencia       String
  valorServico      Float
  discriminacao     String
  status            StatusNotaFiscal @default(PENDENTE)
  numeroNota        String?
  serieNota         String?
  codigoVerificacao String?
  protocolo         String?
  mensagemErro      String?
  dataEmissao       DateTime?
  usuario           String
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  @@index([alunoId])
  @@index([competencia])
  @@index([status])
}

enum StatusNotaFiscal {
  PENDENTE
  EMITIDA
  ERRO
  CANCELADA
}

/// Boleto de mensalidade via API de Cobrança de Títulos do Banrisul — ver
/// lib/banrisul.ts. Hoje a cobrança é feita por fora do sistema (Banrisul,
/// manual); isso aqui é a estrutura pronta pra registrar o boleto direto pelo
/// ERP quando o Convênio de Cobrança (Código de Beneficiário) da escola +
/// credenciais da API estiverem configurados.
model Boleto {
  id             String       @id @default(cuid())
  aluno          Aluno        @relation(fields: [alunoId], references: [id])
  alunoId        String
  /// "AAAA-MM" — mês de referência da mensalidade
  competencia    String
  valor          Float
  vencimento     DateTime
  status         StatusBoleto @default(PENDENTE)
  nossoNumero    String?
  linhaDigitavel String?
  codigoBarras   String?
  mensagemErro   String?
  dataRegistro   DateTime?
  usuario        String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([alunoId])
  @@index([competencia])
  @@index([status])
}

enum StatusBoleto {
  PENDENTE
  REGISTRADO
  ERRO
  PAGO
  CANCELADO
}

model Funcionario {
  id                     String                 @id @default(cuid())
  nome                   String
  // Opcional de propósito: melhor sem CPF do que com um fictício (era gerado
  // automaticamente no cadastro inicial — corrigido a pedido do dono do sistema).
  cpf                    String?                @unique
  cargo                  String
  setor                  String
  telefone               String?
  email                  String?
  dataNascimento         DateTime?
  admissao               DateTime
  ativo                  Boolean                @default(true)
  participaPonto         Boolean                @default(false)
  jornadaPrevistaMinutos Int?
  documentos             DocumentoFuncionario[]
  registrosPonto         RegistroPonto[]
  chavesRetiradas        EmprestimoChave[]
  createdAt              DateTime               @default(now())
}

model RegistroPonto {
  id            String          @id @default(cuid())
  funcionario   Funcionario     @relation(fields: [funcionarioId], references: [id], onDelete: Cascade)
  funcionarioId String
  data          DateTime
  entrada1      Int?
  saida1        Int?
  entrada2      Int?
  saida2        Int?
  entrada3      Int?
  saida3        Int?
  ocorrencia    OcorrenciaPonto @default(NORMAL)
  observacao    String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@unique([funcionarioId, data])
}

enum OcorrenciaPonto {
  NORMAL
  FALTA
  FERIADO
  FERIAS
  ATESTADO
  FOLGA
  DSR
}

model DocumentoFuncionario {
  id            String      @id @default(cuid())
  funcionario   Funcionario @relation(fields: [funcionarioId], references: [id], onDelete: Cascade)
  funcionarioId String
  tipo          String
  nomeArquivo   String
  arquivo       String
  createdAt     DateTime    @default(now())
}

model ItemEstoque {
  id            String                @id @default(cuid())
  nome          String
  categoria     String
  unidade       String
  quantidade    Int                   @default(0)
  minimo        Int                   @default(5)
  localizacao   String?
  fornecedor    String?
  movimentacoes MovimentacaoEstoque[]
  updatedAt     DateTime              @updatedAt
}

model MovimentacaoEstoque {
  id          String      @id @default(cuid())
  item        ItemEstoque @relation(fields: [itemId], references: [id])
  itemId      String
  tipo        TipoMov
  quantidade  Int
  motivo      String?
  responsavel String?
  destino     String?
  anulada     Boolean     @default(false)
  refId       String?
  createdAt   DateTime    @default(now())
}

enum TipoMov {
  ENTRADA
  SAIDA
  AJUSTE
  ESTORNO
}

model Cardapio {
  id                String   @id @default(cuid())
  data              DateTime @unique
  fruta             String?
  almoco            String?
  lancheInfantil    String?
  lancheFundamental String?
  lanche            String? // legado (antes do detalhamento por turno/segmento) — não usado na UI
  createdAt         DateTime @default(now())
}

model Chave {
  id          String            @id @default(cuid())
  sala        String
  ativa       Boolean           @default(true)
  emprestimos EmprestimoChave[]
}

model EmprestimoChave {
  id          String    @id @default(cuid())
  chave       Chave     @relation(fields: [chaveId], references: [id])
  chaveId     String
  /// Nome do responsável — sempre preenchido a partir do Funcionario selecionado
  /// (snapshot, igual a NotaFiscal/LogAtividade). Registros antigos (antes do
  /// autocomplete) podem não ter responsavelFuncionarioId — não foram migrados.
  responsavel String
  responsavelFuncionario   Funcionario? @relation(fields: [responsavelFuncionarioId], references: [id])
  responsavelFuncionarioId String?
  retirada    DateTime  @default(now())
  devolucao   DateTime?
}

model MuralAviso {
  id        String         @id @default(cuid())
  titulo    String
  conteudo  String
  autor     String
  autorId   String?
  autorUser User?          @relation(fields: [autorId], references: [id], onDelete: SetNull)
  fixado    Boolean        @default(false)
  createdAt DateTime       @default(now())
  leituras  AvisoLeitura[]
}

model AvisoLeitura {
  id        String     @id @default(cuid())
  avisoId   String
  aviso     MuralAviso @relation(fields: [avisoId], references: [id], onDelete: Cascade)
  userId    String
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime   @default(now())

  @@unique([avisoId, userId])
}

model LogAtividade {
  id         String   @id @default(cuid())
  acao       String
  entidade   String
  entidadeId String
  usuario    String
  createdAt  DateTime @default(now())

  @@index([entidade, createdAt])
}

model EventoCalendario {
  id        String   @id @default(cuid())
  titulo    String
  data      DateTime
  categoria String
  descricao String?
  createdAt DateTime @default(now())
}

model DocumentoInstitucional {
  id         String    @id @default(cuid())
  titulo     String
  categoria  String
  link       String
  validade   DateTime?
  observacao String?
  createdAt  DateTime  @default(now())
}
