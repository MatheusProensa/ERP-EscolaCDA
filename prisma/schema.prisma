// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                     String              @id @default(cuid())
  name                   String
  email                  String              @unique
  password               String
  role                   Role                @default(SECRETARIA)
  /// Foto de perfil (JPEG em base64, redimensionado no navegador antes do
  /// upload — ver components/ui/PhotoUpload.tsx). Vira o "image" padrão do
  /// NextAuth na sessão.
  foto                   String?
  tentativasFalhas       Int                 @default(0)
  bloqueadoAte           DateTime?
  /// Marcado quando o usuário pede "esqueci minha senha" na tela de login —
  /// sem envio de e-mail (não tem provedor configurado), um ADMIN/DIREÇÃO vê
  /// o pedido na tela de Usuários e redefine manualmente (fluxo que já existia).
  pedidoResetSenhaEm     DateTime?
  /// Marca a coordenadora pedagógica — enxerga TODAS as turmas na Área
  /// Pedagógica (não só as que ela tem VinculoPedagogico) e acompanha/
  /// comenta as entregas de cada uma. Separado do Role porque "Pedagógico"
  /// já é usado por mais gente (professoras regentes/especialistas) que não
  /// tem essa visão ampla — é uma marcação extra dentro do Role, não um Role
  /// à parte.
  coordenaAreaPedagogica Boolean             @default(false)
  createdAt              DateTime            @default(now())
  mensagensEnviadas      Mensagem[]          @relation("MensagensEnviadas")
  mensagensRecebidas     Mensagem[]          @relation("MensagensRecebidas")
  notificacoes           Notificacao[]
  avisosMural            MuralAviso[]
  leiturasAvisos         AvisoLeitura[]
  permissoes             PermissaoUsuario[]
  vinculosPedagogico     VinculoPedagogico[]
  projetosPedagogicos    ProjetoPedagogico[]
  planejamentos          Planejamento[]
  planejamentosRevisados Planejamento[]      @relation("ComentariosPlanejamento")
  prazosDefinidos        PrazoPedagogico[]
  modelosParecer         ModeloParecer[]
  pareceres              Parecer[]
  portfolioItens         PortfolioItem[]
  tutoriaisVistos        TutorialVisto[]
}

/// Permissão granular por pessoa/setor — sobrepõe o pacote padrão do Role
/// quando existe uma linha aqui pro (usuário, módulo). Sem linha = usa o
/// que o Role já libera (comportamento de sempre). Ver lib/permissoes.ts.
model PermissaoUsuario {
  id        String         @id @default(cuid())
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  modulo    String
  nivel     NivelPermissao
  updatedAt DateTime       @updatedAt

  @@unique([userId, modulo])
  @@index([userId])
}

enum NivelPermissao {
  NENHUM
  VER
  EDITAR
}

model Mensagem {
  id             String    @id @default(cuid())
  remetente      User      @relation("MensagensEnviadas", fields: [remetenteId], references: [id])
  remetenteId    String
  destinatario   User      @relation("MensagensRecebidas", fields: [destinatarioId], references: [id])
  destinatarioId String
  conteudo       String?
  anexoNome      String?
  anexo          String?
  lida           Boolean   @default(false)
  excluida       Boolean   @default(false)
  editadaEm      DateTime?
  createdAt      DateTime  @default(now())
  /// Muda em qualquer alteração (lida, edição, exclusão) — é o que o polling
  /// incremental usa pra saber que uma mensagem JÁ mostrada na tela mudou,
  /// não só pra achar mensagem nova.
  updatedAt      DateTime  @default(now()) @updatedAt

  // "createdAt" no fim de cada uma cobre o ORDER BY + LIMIT de abrir uma
  // conversa (pega as mais recentes) sem precisar ordenar a conversa inteira
  // na mão — uma índice pra cada lado do OR (remetente/destinatário trocados).
  @@index([remetenteId, destinatarioId, createdAt])
  @@index([destinatarioId, remetenteId, createdAt])
  @@index([destinatarioId, lida])
}

model Notificacao {
  id        String   @id @default(cuid())
  usuario   User     @relation(fields: [usuarioId], references: [id])
  usuarioId String
  tipo      String
  titulo    String
  corpo     String?
  link      String?
  lida      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([usuarioId, lida])
}

enum Role {
  ADMIN
  DIRECAO
  SECRETARIA // legado, não usado em novos cadastros — ver ADMINISTRATIVO
  FINANCEIRO
  PEDAGOGICO
  ADMINISTRATIVO
  /// Nutricionista — separado de ADMINISTRATIVO (pedido do dono, set/2026,
  /// depois de ver a nutricionista contada junto com a secretaria/portaria no
  /// resumo de Usuários). Acesso real a Cardápio/Avaliação Nutricional
  /// continua sendo só pela grade de permissões por pessoa (esses 2 módulos
  /// já não olham pro Role — ver acessoPermitido em lib/permissoes.ts).
  NUTRICAO
}

model AnoLetivo {
  id         String      @id @default(cuid())
  ano        Int         @unique
  ativo      Boolean     @default(false)
  turmas     Turma[]
  matriculas Matricula[]
}

model Turma {
  id                    String                 @id @default(cuid())
  nome                  String
  turno                 Turno
  capacidade            Int                    @default(25)
  anoLetivo             AnoLetivo              @relation(fields: [anoLetivoId], references: [id])
  anoLetivoId           String
  matriculas            Matricula[]
  listaEspera           ListaEspera[]
  vinculosPedagogico    VinculoPedagogico[]
  projetosPedagogicos   ProjetoPedagogico[]
  planejamentos         Planejamento[]
  horariosEspecializada HorarioEspecializada[]
  momentosRotina        MomentoRotina[]
  modelosParecer        ModeloParecer[]
  pareceres             Parecer[]
  portfolioItens        PortfolioItem[]
  createdAt             DateTime               @default(now())

  @@unique([nome, anoLetivoId])
}

/// Vínculo de uma professora com uma turma na Área Pedagógica (parecer,
/// planejamento, portfólio) — a permissão granular hoje (PermissaoUsuario) só
/// enxerga módulo inteiro, sem noção de "só a minha turma"; esta tabela é a
/// camada extra de escopo por turma, só pra esse módulo.
/// REGENTE: 1 vínculo por turma, sem matéria — responsável pela turma inteira.
/// ESPECIALISTA (Ed. Física, Musicalização, Inglês/Bilíngue etc.): vínculo por
/// matéria, podendo cobrir várias turmas — achado real (out/2026) lendo
/// pareceres reais da escola: a mesma especialista escreve a mesma seção em
/// N turmas diferentes, nunca "dona" de 1 turma só como a regente.
model VinculoPedagogico {
  id        String          @id @default(cuid())
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  turma     Turma           @relation(fields: [turmaId], references: [id], onDelete: Cascade)
  turmaId   String
  papel     PapelPedagogico
  /// Só preenchido quando papel = ESPECIALISTA. Texto livre por enquanto (ex.:
  /// "Educação Física", "Inglês") — vira lista fechada se a variação real
  /// pedir isso mais pra frente.
  materia   String?
  createdAt DateTime        @default(now())

  // Nota: com materia NULL (caso REGENTE), o Postgres trata cada NULL como
  // distinto — essa constraint não barra duplicata de regente na prática,
  // só documenta a intenção. A checagem de duplicidade real fica na API.
  @@unique([userId, turmaId, materia])
  @@index([turmaId])
  @@index([userId])
}

enum PapelPedagogico {
  REGENTE
  ESPECIALISTA
}

/// Projeto pedagógico de uma turma — a unidade real de planejamento da
/// Educação Infantil (achado real, set/2026: pasta de planejamento real da
/// escola, modelo "PROJETO PEDAGÓGICO" usado hoje no Word). Nasce dos
/// interesses/necessidades observados nas crianças e dura o tempo que o
/// projeto precisar (não é fixo por semana/mês) — quando um projeto se
/// encerra, a regente cria o próximo. Por turma desde o início (substitui o
/// antigo TemaPlanejamento, que era um catálogo global da coordenação —
/// correção do dono, set/2026: "os temas são definidos por cada prof").
model ProjetoPedagogico {
  id                       String         @id @default(cuid())
  turma                    Turma          @relation(fields: [turmaId], references: [id], onDelete: Cascade)
  turmaId                  String
  nome                     String
  interessesObservados     String?
  necessidadesObservadas   String?
  acoesNarrativasPerguntas String?
  intencionalidades        String?
  justificativa            String?
  /// Só 1 projeto ativo por turma por vez (regra aplicada na API, não no
  /// banco) — os demais viram histórico, continuam ligados aos planejamentos
  /// antigos que os referenciaram.
  ativo                    Boolean        @default(true)
  autor                    User           @relation(fields: [autorId], references: [id])
  autorId                  String
  createdAt                DateTime       @default(now())
  updatedAt                DateTime       @updatedAt
  planejamentos            Planejamento[]

  @@index([turmaId])
  @@index([turmaId, ativo])
}

/// Planejamento semanal de uma turma — 1 por (turma, semana), dentro do
/// projeto pedagógico ativo (achado real: os planejamentos reais da escola
/// são organizados em semanas dentro de um projeto/mês). Escrito pela
/// professora regente.
model Planejamento {
  id                        String             @id @default(cuid())
  turma                     Turma              @relation(fields: [turmaId], references: [id], onDelete: Cascade)
  turmaId                   String
  projeto                   ProjetoPedagogico? @relation(fields: [projetoId], references: [id], onDelete: SetNull)
  projetoId                 String?
  /// Segunda-feira da semana que esse planejamento cobre (meia-noite UTC,
  /// mesma convenção de EventoCalendario) — identidade junto com a turma.
  semanaInicio              DateTime
  /// Lista de materiais da semana (achado real: 1 bloco "MATERIAIS" por
  /// semana no documento real, não por dia).
  materiais                 String?
  /// Tarde Cultural (achado real, set/2026, documento MODELO_PLANEJAMENTO_CDA:
  /// bloco "OBS: Em caso de Tarde Cultural" com 2 partes — o que a turma vai
  /// apresentar (só quando é o dia dela) e a lista de materiais necessários,
  /// que "será entregue para a prof que separa o material após a impressão".
  /// Os 2 opcionais, só preenche quando tem Tarde Cultural naquela semana.
  tardeCulturalApresentacao String?
  tardeCulturalMateriais    String?
  /// Rascunho até a regente clicar em "Finalizar" — pedido do dono, set/2026:
  /// um botão explícito de entrega, em vez do status "Entregue" ser só um
  /// heurístico de "tem algo preenchido" (mesmo padrão já usado no Parecer,
  /// ver StatusParecer). O painel da coordenadora passa a contar ENVIADO.
  /// Fluxo de aprovação (pedido do dono, set/2026): ENVIADO vira APROVADO ou
  /// DEVOLVIDO quando a coordenadora revisa; DEVOLVIDO some assim que a
  /// regente reenvia (volta pra ENVIADO).
  status                    StatusPlanejamento @default(RASCUNHO)
  /// Comentário da coordenadora ao aprovar/devolver — null quando ainda não
  /// foi revisado, ou quando aprovado sem nada a dizer (curtida simples).
  comentarioCoordenadora    String?
  comentarioAutor           User?              @relation("ComentariosPlanejamento", fields: [comentarioAutorId], references: [id])
  comentarioAutorId         String?
  comentarioEm              DateTime?
  /// Confirmação de leitura da regente ("li e entendi") — fecha o loop sem
  /// depender de WhatsApp. Zera de novo a cada novo comentário/devolução.
  liComentarioEm            DateTime?
  autor                     User               @relation(fields: [autorId], references: [id])
  autorId                   String
  dias                      PlanejamentoDia[]
  createdAt                 DateTime           @default(now())
  updatedAt                 DateTime           @updatedAt

  @@unique([turmaId, semanaInicio])
  @@index([turmaId])
  @@index([projetoId])
}

enum StatusPlanejamento {
  RASCUNHO
  ENVIADO
  /// Coordenadora revisou e aprovou (👍, com ou sem comentário).
  APROVADO
  /// Coordenadora pediu revisão — comentarioCoordenadora explica o quê.
  DEVOLVIDO
}

enum TipoDiaPlanejamento {
  /// Temática do dia + Momento inicial/fundamental/final (achado real: dias
  /// ímpares da semana no documento real, ex.: segunda/quarta/sexta).
  TEMATICA
  /// Contexto organizado + Roda de conversa + Organização do contexto
  /// (achado real: dias pares, ex.: terça/quinta).
  CONTEXTO
}

/// Um dia dentro do planejamento da semana — estrutura real copiada do
/// documento MODELO_PLANEJAMENTO_CDA (achado real, set/2026), com 2 formatos
/// de dia (`tipo`) que a professora alterna ao longo da semana. `conteudo`
/// guarda os campos de texto de cada bloco (temática, momentos, perguntas
/// norteadoras) em JSON — ver ConteudoDiaPlanejamento em lib/planejamento.ts
/// pras chaves esperadas por tipo — em vez de uma coluna por campo, porque a
/// estrutura ainda pode mudar com o uso real (v1 dessa reformulação).
model PlanejamentoDia {
  id             String              @id @default(cuid())
  planejamento   Planejamento        @relation(fields: [planejamentoId], references: [id], onDelete: Cascade)
  planejamentoId String
  data           DateTime
  tipo           TipoDiaPlanejamento @default(TEMATICA)
  conteudo       Json
  /// Horário das aulas especializadas nesse dia (Bilíngue, Ed. Física,
  /// Capoeira, Musicalização). Pré-preenchido a partir de
  /// HorarioEspecializada (o horário fixo da turma) e editável aqui só pra
  /// exceção pontual daquela semana (sub, feriado, mudança de horário).
  especializadas String?

  @@unique([planejamentoId, data])
}

/// Horário fixo das aulas especializadas de uma turma, por dia da semana —
/// achado real (set/2026): o horário se repete igual toda semana no
/// documento real, então preencher 1 vez aqui evita digitar de novo em cada
/// planejamento semanal (mesmo raciocínio do tipoPadraoDoDia). diaSemana usa
/// o mesmo índice de OFFSETS_DIA_UTIL (0=segunda ... 4=sexta).
model HorarioEspecializada {
  id        String @id @default(cuid())
  turma     Turma  @relation(fields: [turmaId], references: [id], onDelete: Cascade)
  turmaId   String
  diaSemana Int
  texto     String

  @@unique([turmaId, diaSemana])
}

/// Planejamento do Cotidiano — descrição da rotina diária da turma (achado
/// real, set/2026, documento MODELO_PLANEJAMENTO_CDA: "Chegada/Acolhida",
/// "Lanche 1", "Pracinha", "Soninho" etc., cada um com como acontece, onde,
/// que materiais, rituais). Diferente do Planejamento semanal: não muda toda
/// semana, é a rotina fixa da turma — preenche/ajusta só quando a rotina em
/// si muda, não repete todo mês. A lista de momentos é livre por turma (o
/// próprio doc real diz "completar conforme a turma, acrescentar ou retirar")
/// — por isso é uma lista, não campos fixos.
model MomentoRotina {
  id        String @id @default(cuid())
  turma     Turma  @relation(fields: [turmaId], references: [id], onDelete: Cascade)
  turmaId   String
  ordem     Int
  nome      String
  descricao String

  @@index([turmaId, ordem])
}

/// Prazo mensal do Planejamento, definido pela coordenadora (pedido do dono,
/// set/2026: "coordenadora define o prazo do mês"). 1 prazo por mês, vale
/// pra TODAS as turmas — ainda não existe noção de prazo por turma/módulo,
/// só Planejamento por enquanto (Parecer/Portfólio ficam de fora dessa v1).
model PrazoPedagogico {
  id                 String   @id @default(cuid())
  /// "YYYY-MM"
  mes                String   @unique
  dataLimite         DateTime
  definidoPor        User     @relation(fields: [definidoPorId], references: [id])
  definidoPorId      String
  updatedAt          DateTime @updatedAt
  /// Evento correspondente no Calendário geral da escola (pedido do dono,
  /// set/2026: "prazo de entrega vira automaticamente um evento no
  /// calendário") — guarda o id pra ATUALIZAR o mesmo evento quando a
  /// coordenadora muda a data, em vez de criar um novo toda vez.
  eventoCalendarioId String?  @unique
}

/// Modelo de parecer — a lista de parágrafos que a professora vai preencher
/// (achado real, out/2026: os PDFs de orientação da escola já têm exatamente
/// esse formato — Conteúdo + Pergunta Norteadora por parágrafo). Escopado por
/// TURMA (correção do dono, set/2026: "do parecer tbm, deveria ser em cada
/// turma" — cada turma monta/ajusta o próprio modelo, não é mais um catálogo
/// global editado só pela coordenação). A checklist A/EP/NA exclusiva do
/// Fundamental (achado real: não existe no Infantil) fica de fora por
/// enquanto — parecer aqui é só narrativa guiada por parágrafo.
model ModeloParecer {
  id          String                   @id @default(cuid())
  titulo      String
  turma       Turma                    @relation(fields: [turmaId], references: [id], onDelete: Cascade)
  turmaId     String
  criadoPor   User                     @relation(fields: [criadoPorId], references: [id])
  criadoPorId String
  createdAt   DateTime                 @default(now())
  paragrafos  ParagrafoModeloParecer[]
  pareceres   Parecer[]

  @@index([turmaId])
}

/// Um parágrafo dentro do modelo — título do tema + a pergunta norteadora que
/// aparece como guia ao lado do campo de texto (mesmo texto que already
/// existe nos PDFs de orientação reais da escola).
model ParagrafoModeloParecer {
  id                     String                  @id @default(cuid())
  modelo                 ModeloParecer           @relation(fields: [modeloId], references: [id], onDelete: Cascade)
  modeloId               String
  ordem                  Int
  titulo                 String
  perguntaNorteadora     String?
  parecerAlunoParagrafos ParecerAlunoParagrafo[]

  @@unique([modeloId, ordem])
}

/// Um ciclo de parecer de uma turma (ex.: "1º Trimestre 2026" pro
/// Fundamental, "1º Semestre 2026" pro Infantil — achado real: a cadência
/// muda por público, por isso "periodo" é texto livre, não um enum fixo).
/// Guarda o texto compartilhado da turma; o texto individual de cada aluno
/// fica em ParecerAluno.
model Parecer {
  id         String         @id @default(cuid())
  turma      Turma          @relation(fields: [turmaId], references: [id], onDelete: Cascade)
  turmaId    String
  modelo     ModeloParecer  @relation(fields: [modeloId], references: [id])
  modeloId   String
  periodo    String
  /// Texto sobre a turma inteira — igual pra todos os alunos desse ciclo
  /// (achado real nos .docx entregues: 1 bloco "AVALIAÇÃO DESCRITIVA DA
  /// TURMA" compartilhado, repetido só por engano em alguns arquivos reais).
  textoTurma String?
  autor      User           @relation(fields: [autorId], references: [id])
  autorId    String
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
  alunos     ParecerAluno[]

  @@unique([turmaId, periodo])
  @@index([modeloId])
}

enum StatusParecer {
  RASCUNHO
  ENVIADO
}

/// O parecer individual de 1 aluno dentro de um ciclo — puxa nome/turma do
/// cadastro (achado real: professoras digitavam isso à mão em cada arquivo,
/// com rótulo inconsistente e às vezes errado). Os parágrafos ficam em
/// ParecerAlunoParagrafo, um por ParagrafoModeloParecer do modelo escolhido.
model ParecerAluno {
  id         String                  @id @default(cuid())
  parecer    Parecer                 @relation(fields: [parecerId], references: [id], onDelete: Cascade)
  parecerId  String
  aluno      Aluno                   @relation(fields: [alunoId], references: [id], onDelete: Cascade)
  alunoId    String
  status     StatusParecer           @default(RASCUNHO)
  paragrafos ParecerAlunoParagrafo[]
  updatedAt  DateTime                @updatedAt

  @@unique([parecerId, alunoId])
  @@index([alunoId])
}

model ParecerAlunoParagrafo {
  id             String                 @id @default(cuid())
  parecerAluno   ParecerAluno           @relation(fields: [parecerAlunoId], references: [id], onDelete: Cascade)
  parecerAlunoId String
  paragrafo      ParagrafoModeloParecer @relation(fields: [paragrafoId], references: [id])
  paragrafoId    String
  conteudo       String

  @@unique([parecerAlunoId, paragrafoId])
}

/// Um item do portfólio de um aluno — foto + legenda curta, datado, formando
/// uma linha do tempo (não é um documento com "período" como o Parecer;
/// portfólio é acúmulo contínuo ao longo do ano, então não tem essa noção de
/// ciclo). turmaId fica gravado no momento do upload (não vem só via Aluno)
/// pra escopar por vínculo da regente sem precisar seguir Aluno→Matrícula
/// toda vez, e pra manter o item ligado à turma de quando foi tirado mesmo
/// que o aluno mude de turma no ano seguinte.
model PortfolioItem {
  id        String   @id @default(cuid())
  aluno     Aluno    @relation(fields: [alunoId], references: [id], onDelete: Cascade)
  alunoId   String
  turma     Turma    @relation(fields: [turmaId], references: [id], onDelete: Cascade)
  turmaId   String
  /// JPEG em base64 (mesmo padrão de foto de perfil, ver PhotoUpload) — lado
  /// máximo bem maior (1600px) porque aqui é pra ver grande, não avatar.
  foto      String
  legenda   String?
  autor     User     @relation(fields: [autorId], references: [id])
  autorId   String
  createdAt DateTime @default(now())

  @@index([alunoId, createdAt])
  @@index([turmaId])
}

enum Turno {
  MANHA
  TARDE
}

/// Funil de famílias interessadas (pré-matrícula) — espelha o "Controle de
/// Interessados" que a secretaria já mantinha à mão no Canva: contato,
/// o que a família busca, data da visita e o desfecho de cada chamada.
model ListaEspera {
  id                  String            @id @default(cuid())
  nomeCrianca         String
  dataNascimento      DateTime?
  /// Foto da criança (base64), mesmo padrão do Aluno.foto — vira o avatar
  /// na tabela e na tela de perfil, opcional.
  foto                String?
  nomeResponsavel     String
  /// Preenchido só quando quem liga não é o responsável direto (ex.: "Vó", "Irmã").
  parentescoContato   String?
  telefoneResponsavel String
  emailResponsavel    String?
  turmaDesejada       Turma?            @relation(fields: [turmaDesejadaId], references: [id])
  turmaDesejadaId     String?
  /// Turma/turno/ano de interesse em texto livre, pra quando não bate com
  /// nenhuma Turma já cadastrada (ex. interesse já pro ano letivo seguinte).
  interesseTexto      String?
  dataPrimeiroContato DateTime?
  /// O que a família prioriza/busca numa escola — texto livre, é informação
  /// valiosa pro atendimento e pra entender o perfil de quem procura a CDA.
  oQueBusca           String?
  dataVisita          DateTime?
  observacoes         String?
  status              StatusListaEspera @default(AGUARDANDO)
  createdAt           DateTime          @default(now())
}

enum StatusListaEspera {
  AGUARDANDO
  CONTATADO
  /// Ligou, precisa ligar de novo (não conseguiu falar, pediu pra ligar depois etc.)
  CHAMAR_NOVAMENTE
  /// Ligou(s) e não teve retorno nenhum até agora.
  NAO_RESPONDEU
  /// Convite pendente pro evento de Portas Abertas.
  PORTAS_ABERTAS
  /// Visitou a escola mas não respondeu mais depois disso.
  SEM_RETORNO_APOS_VISITA
  /// Recusou por motivo alheio à escola (localidade, não vai trocar de escola esse ano etc.)
  NAO_TEM_INTERESSE
  /// Recusou especificamente pelo valor da mensalidade.
  VALOR_ULTRAPASSA
  /// A escola que não tinha vaga na turma desejada — diferente de
  /// NAO_TEM_INTERESSE, aqui é a família que queria e não pôde. Rechamar
  /// quando abrir vaga.
  SEM_VAGA
  MATRICULADO
  DESISTIU
}

model Aluno {
  id                 String   @id @default(cuid())
  nome               String
  nomeSocial         String?
  dataNascimento     DateTime
  naturalidade       String?
  cpf                String?  @unique
  rg                 String?
  certidaoNascimento String?
  foto               String?
  endereco           String?
  bairro             String?
  cidade             String?
  cep                String?
  tipoSanguineo      String?
  convenioMedico     String?
  medicacaoContinua  String?
  alergias           String?
  restricoes         String?
  necessidadesEsp    String?
  autorizacaoImagem  Boolean  @default(false)

  // Dados do Censo Escolar (Educacenso)
  sexo            Sexo?
  racaCor         RacaCor?
  povoIndigena    String?
  nacionalidade   Nacionalidade @default(BRASILEIRA)
  municipioNasc   String?
  ufNasc          String?
  filiacao1       String?
  filiacao2       String?
  bolsaFamilia    Boolean       @default(false)
  deficiencia     Boolean       @default(false)
  tipoDeficiencia String?
  recursosAcessib String?
  nis             String?

  // Dados da Ficha de Matrícula (rotina/perfil da criança)
  temIrmaos              Boolean?
  idadesIrmaos           String?
  usaBico                Boolean?
  usaMamadeira           Boolean?
  obsBicoMamadeira       String?
  jaFrequentouEscola     Boolean?
  duracaoEscolaAnterior  String?
  rotinaSonoAlimentacao  String?
  brincadeirasPrediletas String?
  reacoesContrariado     String?

  matriculas             Matricula[]
  responsaveis           Responsavel[]
  pessoasAutorizadas     PessoaAutorizada[]
  notasFiscais           NotaFiscal[]
  boletos                Boleto[]
  avaliacoesNutricionais AvaliacaoNutricional[]
  pareceres              ParecerAluno[]
  portfolioItens         PortfolioItem[]
  createdAt              DateTime               @default(now())
  updatedAt              DateTime               @updatedAt

  @@index([nome])
}

enum Sexo {
  M
  F
}

enum RacaCor {
  BRANCA
  PRETA
  PARDA
  AMARELA
  INDIGENA
  NAO_DECLARADA
}

enum Nacionalidade {
  BRASILEIRA
  ESTRANGEIRA
}

model Responsavel {
  id                String  @id @default(cuid())
  nome              String
  parentesco        String
  cpf               String?
  telefone          String
  telefoneFixo      String?
  telefoneComercial String?
  email             String?
  rg                String?
  escolaridade      String?
  profissao         String?
  endereco          String?
  cep               String?
  autorizado        Boolean @default(true)
  aluno             Aluno   @relation(fields: [alunoId], references: [id])
  alunoId           String
}

/// Pessoas além dos responsáveis já cadastrados que também podem buscar o aluno na escola.
model PessoaAutorizada {
  id         String @id @default(cuid())
  nome       String
  parentesco String
  aluno      Aluno  @relation(fields: [alunoId], references: [id], onDelete: Cascade)
  alunoId    String
}

/// Um registro de peso/altura da criança numa data — a Nutricionista lança e o
/// sistema classifica sozinho (curva de IMC por idade da OMS, ver
/// lib/avaliacaoNutricional.ts). pesoKg/alturaCm ficam salvos crus; a
/// classificação (percentil, diagnóstico) é sempre recalculada na hora de
/// exibir, não gravada aqui — assim, se a tabela de referência for revisada um
/// dia, o histórico já cadastrado se ajusta sozinho, sem precisar reprocessar
/// nada no banco.
model AvaliacaoNutricional {
  id          String   @id @default(cuid())
  aluno       Aluno    @relation(fields: [alunoId], references: [id], onDelete: Cascade)
  alunoId     String
  data        DateTime
  pesoKg      Float
  alturaCm    Float
  observacoes String?
  /// Snapshot de quem lançou (mesmo padrão do LogAtividade.usuario) — não
  /// aponta pro User, então continua legível mesmo se a conta for excluída depois.
  usuario     String
  createdAt   DateTime @default(now())

  @@index([alunoId])
}

model Matricula {
  id               String            @id @default(cuid())
  aluno            Aluno             @relation(fields: [alunoId], references: [id])
  alunoId          String
  turma            Turma             @relation(fields: [turmaId], references: [id])
  turmaId          String
  anoLetivo        AnoLetivo         @relation(fields: [anoLetivoId], references: [id])
  anoLetivoId      String
  situacao         SituacaoMatricula @default(ATIVA)
  dataMatricula    DateTime          @default(now())
  // Só o valor contratado — fica pra constar no contrato (lib/gerarContratoPdf).
  // A escola cobra a mensalidade por fora (Banrisul), então não existe mais
  // controle de cobrança/pagamento dentro do sistema (era Mensalidade/Pagamento).
  valorMensalidade Float?
  contrato         Contrato?
  updatedAt        DateTime          @updatedAt

  @@index([alunoId])
  @@index([turmaId])
  @@index([situacao])
  @@index([anoLetivoId])
  // Combinação mais repetida no sistema (matrícula ativa do ano letivo corrente).
  @@index([anoLetivoId, situacao])
}

enum SituacaoMatricula {
  ATIVA
  TRANCADA
  CANCELADA
  TRANSFERIDA
  CONCLUIDA
}

model Contrato {
  id          String    @id @default(cuid())
  matricula   Matricula @relation(fields: [matriculaId], references: [id])
  matriculaId String    @unique
  arquivo     String?
  assinado    Boolean   @default(false)
  dataEnvio   DateTime?
  createdAt   DateTime  @default(now())

  /// Assinatura eletrônica simples por link (MP 2.200-2/2001) — sem certificado
  /// ICP-Brasil, só registra consentimento + identificação de quem assinou.
  tokenAssinatura String?   @unique
  nomeAssinante   String?
  cpfAssinante    String?
  ipAssinatura    String?
  assinadoEm      DateTime?

  /// Retrato dos dados usados pra gerar o PDF (o que a tela de revisão deixa
  /// editar) — sem isso, assinar pelo link teria que re-derivar tudo do
  /// cadastro atual do aluno, que pode já ter mudado desde a geração e perderia
  /// coisas como dia/mês de vencimento (não existem em outro lugar do banco).
  alunoNomeSnapshot           String?
  alunoNascimentoSnapshot     DateTime?
  responsavelNomeSnapshot     String?
  responsavelCpfSnapshot      String?
  turmaNomeSnapshot           String?
  turnoLabelSnapshot          String?
  anoLetivoSnapshot           Int?
  valorMensalidadeSnapshot    Float?
  dataMatriculaSnapshot       DateTime?
  diaVencimentoSnapshot       String?
  mesInicioVencimentoSnapshot String?
}

/// NFS-e (nota fiscal de serviço) emitida via webservice ABRASF do ISS.net
/// (Prefeitura de Santa Maria) — ver lib/issnet.ts. A escola cobra a
/// mensalidade por fora (Banrisul); isso aqui é só a obrigação fiscal de
/// emitir nota do serviço prestado, independente de como foi cobrado.
model NotaFiscal {
  id                String           @id @default(cuid())
  aluno             Aluno            @relation(fields: [alunoId], references: [id])
  alunoId           String
  /// "AAAA-MM" — mês de referência do serviço (não precisa ser o mês da emissão)
  competencia       String
  valorServico      Float
  discriminacao     String
  status            StatusNotaFiscal @default(PENDENTE)
  numeroNota        String?
  serieNota         String?
  codigoVerificacao String?
  protocolo         String?
  mensagemErro      String?
  dataEmissao       DateTime?
  usuario           String
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  @@index([alunoId])
  @@index([competencia])
  @@index([status])
}

enum StatusNotaFiscal {
  PENDENTE
  EMITIDA
  ERRO
  CANCELADA
}

/// Boleto de mensalidade via API de Cobrança de Títulos do Banrisul — ver
/// lib/banrisul.ts. Hoje a cobrança é feita por fora do sistema (Banrisul,
/// manual); isso aqui é a estrutura pronta pra registrar o boleto direto pelo
/// ERP quando o Convênio de Cobrança (Código de Beneficiário) da escola +
/// credenciais da API estiverem configurados.
model Boleto {
  id             String       @id @default(cuid())
  aluno          Aluno        @relation(fields: [alunoId], references: [id])
  alunoId        String
  /// "AAAA-MM" — mês de referência da mensalidade
  competencia    String
  valor          Float
  vencimento     DateTime
  status         StatusBoleto @default(PENDENTE)
  nossoNumero    String?
  linhaDigitavel String?
  codigoBarras   String?
  mensagemErro   String?
  dataRegistro   DateTime?
  usuario        String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([alunoId])
  @@index([competencia])
  @@index([status])
}

enum StatusBoleto {
  PENDENTE
  REGISTRADO
  ERRO
  PAGO
  CANCELADO
}

model Funcionario {
  id                     String                 @id @default(cuid())
  nome                   String
  // Opcional de propósito: melhor sem CPF do que com um fictício (era gerado
  // automaticamente no cadastro inicial — corrigido a pedido do dono do sistema).
  cpf                    String?                @unique
  cargo                  String
  setor                  String
  telefone               String?
  email                  String?
  dataNascimento         DateTime?
  admissao               DateTime
  // Campo "ativo" removido do schema (set/2026, pedido do dono do sistema:
  // não existe meio-termo reversível — quem sai é excluído de vez). A
  // coluna ainda existe fisicamente no banco (DEFAULT true, sem migração
  // rodada pra apagá-la — esse ambiente não alcança o banco de produção
  // pra migrar), só não é mais lida/gravada por aqui.
  participaPonto         Boolean                @default(false)
  jornadaPrevistaMinutos Int?
  documentos             DocumentoFuncionario[]
  registrosPonto         RegistroPonto[]
  chavesRetiradas        EmprestimoChave[]
  createdAt              DateTime               @default(now())
}

model RegistroPonto {
  id            String          @id @default(cuid())
  funcionario   Funcionario     @relation(fields: [funcionarioId], references: [id], onDelete: Cascade)
  funcionarioId String
  data          DateTime
  entrada1      Int?
  saida1        Int?
  entrada2      Int?
  saida2        Int?
  entrada3      Int?
  saida3        Int?
  ocorrencia    OcorrenciaPonto @default(NORMAL)
  observacao    String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@unique([funcionarioId, data])
}

enum OcorrenciaPonto {
  NORMAL
  FALTA
  FERIADO
  FERIAS
  ATESTADO
  FOLGA
  DSR
}

model DocumentoFuncionario {
  id            String      @id @default(cuid())
  funcionario   Funcionario @relation(fields: [funcionarioId], references: [id], onDelete: Cascade)
  funcionarioId String
  tipo          String
  nomeArquivo   String
  arquivo       String
  createdAt     DateTime    @default(now())
}

model ItemEstoque {
  id            String                @id @default(cuid())
  nome          String
  categoria     String
  unidade       String
  quantidade    Int                   @default(0)
  minimo        Int                   @default(5)
  localizacao   String?
  fornecedor    String?
  movimentacoes MovimentacaoEstoque[]
  updatedAt     DateTime              @updatedAt
}

model MovimentacaoEstoque {
  id          String      @id @default(cuid())
  item        ItemEstoque @relation(fields: [itemId], references: [id])
  itemId      String
  tipo        TipoMov
  quantidade  Int
  motivo      String?
  responsavel String?
  destino     String?
  anulada     Boolean     @default(false)
  refId       String?
  createdAt   DateTime    @default(now())
}

enum TipoMov {
  ENTRADA
  SAIDA
  AJUSTE
  ESTORNO
}

// Substituiu o antigo modelo "Cardapio" (um registro solto por data, 4 campos
// genéricos) — não refletia como a Nutricionista realmente manda o cardápio:
// por público (Maternal/Pré, Berçário, Fundamental), com um padrão de semana
// que SE REPETE (semana 1&3 e semana 2&4 têm o mesmo cardápio no mês todo),
// cada dia com várias refeições em horário fixo. "semanas" guarda os dois
// padrões em JSON — { impar: DiaCardapio[], par: DiaCardapio[] } — pra editar
// um padrão sem mexer no outro. Um registro por (ano, mes, público).
model CardapioMes {
  id        String          @id @default(cuid())
  ano       Int
  mes       Int
  publico   PublicoCardapio
  semanas   Json
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  @@unique([ano, mes, publico])
}

enum PublicoCardapio {
  MATERNAL_PRE
  BERCARIO
  FUNDAMENTAL
}

model Chave {
  id          String            @id @default(cuid())
  sala        String
  ativa       Boolean           @default(true)
  emprestimos EmprestimoChave[]
}

model EmprestimoChave {
  id                       String       @id @default(cuid())
  chave                    Chave        @relation(fields: [chaveId], references: [id])
  chaveId                  String
  /// Nome do responsável — sempre preenchido a partir do Funcionario selecionado
  /// (snapshot, igual a NotaFiscal/LogAtividade). Registros antigos (antes do
  /// autocomplete) podem não ter responsavelFuncionarioId — não foram migrados.
  responsavel              String
  responsavelFuncionario   Funcionario? @relation(fields: [responsavelFuncionarioId], references: [id])
  responsavelFuncionarioId String?
  retirada                 DateTime     @default(now())
  devolucao                DateTime?
}

model MuralAviso {
  id        String         @id @default(cuid())
  titulo    String
  conteudo  String
  autor     String
  autorId   String?
  autorUser User?          @relation(fields: [autorId], references: [id], onDelete: SetNull)
  fixado    Boolean        @default(false)
  createdAt DateTime       @default(now())
  leituras  AvisoLeitura[]
}

model AvisoLeitura {
  id        String     @id @default(cuid())
  avisoId   String
  aviso     MuralAviso @relation(fields: [avisoId], references: [id], onDelete: Cascade)
  userId    String
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime   @default(now())

  @@unique([avisoId, userId])
}

/// Marca que uma pessoa já viu o tutorial guiado de um módulo (ex.:
/// "pedagogico") — ideia confirmada pelo dono, out/2026: tour tipo app/jogo,
/// contextual por tela, disparado só na primeira vez, sempre re-disparável
/// por um botão de ajuda. `modulo` é texto livre (não FK), mesmo espírito de
/// PermissaoUsuario.modulo — cada tela nova só precisa de uma chave nova, sem
/// migração.
model TutorialVisto {
  id      String   @id @default(cuid())
  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId  String
  modulo  String
  vistoEm DateTime @default(now())

  @@unique([userId, modulo])
}

model LogAtividade {
  id         String   @id @default(cuid())
  acao       String
  entidade   String
  entidadeId String
  usuario    String
  createdAt  DateTime @default(now())

  @@index([entidade, createdAt])
}

model EventoCalendario {
  id        String   @id @default(cuid())
  titulo    String
  data      DateTime
  categoria String
  descricao String?
  createdAt DateTime @default(now())
}

/// Escala de horários da equipe (entrada/saída por contraturno-turma, mais
/// avisos de organização) — a Duda mantinha isso num quadro A3 montado no
/// Canva pra cada ano. Cada linha aqui é um "bloco" (card) da tela, na ordem
/// em que aparece.
model EscalaEquipeBloco {
  id                 String          @id @default(cuid())
  ano                Int
  ordem              Int
  titulo             String
  tipo               TipoEscalaBloco @default(TURNO)
  /// Só pra TURNO: horários citados no bloco, como referência visual (não
  /// necessariamente 1 pra 1 com cada entrada/saída — ver nota no seed).
  horariosReferencia String[]        @default([])
  /// Só pra TURNO: [{ pessoa, nota }], nota é o que já vinha escrito no
  /// quadro (ex.: "início do turno", "vem do CTI").
  entradas           Json?
  saidas             Json?
  /// Só pra NOTA: texto livre (organização de turmas, avisos gerais).
  conteudoLivre      String?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
}

enum TipoEscalaBloco {
  TURNO
  NOTA
}

model DocumentoInstitucional {
  id         String    @id @default(cuid())
  titulo     String
  categoria  String
  link       String
  validade   DateTime?
  observacao String?
  createdAt  DateTime  @default(now())
}
